# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Auth (NextAuth v5 / Auth.js)
# ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=REPLACE_WITH_32+_CHAR_RANDOM_STRING   # openssl rand -base64 32

# ─────────────────────────────────────────────
# Database (install PostgreSQL natively)
# https://www.postgresql.org/download/
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/event_reminder"

# ─────────────────────────────────────────────
# WhatsApp Microservice
# ─────────────────────────────────────────────
WHATSAPP_SERVICE_URL=http://localhost:3001
WHATSAPP_SERVICE_SECRET=REPLACE_WITH_STRONG_SECRET  # shared HMAC secret

# ─────────────────────────────────────────────
# Event Defaults (used in reminder cards)
# ─────────────────────────────────────────────
EVENT_NAME="Grand Annual Gala 2026"
EVENT_DATE="2026-12-31T19:00:00.000Z"
EVENT_VENUE="The Royal Palace Banquet Hall"

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=info
