# Copy this file to .env

# HTTP server port
PORT=3001

# Web app base URL (for internal API callbacks)
WEB_APP_URL=http://localhost:3000

# Shared HMAC secret  — must match WHATSAPP_SERVICE_SECRET in apps/web/.env
WHATSAPP_SERVICE_SECRET=REPLACE_WITH_STRONG_SECRET

# CORS: comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info
NODE_ENV=production
