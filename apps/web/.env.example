# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# ─── App ────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=production

# ─── Auth (JWT-only, no database) ───────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32

# Admin credentials — change before going live
ADMIN_EMAIL=admin@yourorg.com
ADMIN_PASSWORD=Admin@123456!

# ─── Data store ─────────────────────────────────────────────────────────────
# Absolute path to the JSON data directory.
# Default: <app root>/data/   (created automatically on first run)
# DATA_DIR=/opt/event-reminder/data

# ─── WhatsApp service ───────────────────────────────────────────────────────
WHATSAPP_SERVICE_URL=http://localhost:3001
WHATSAPP_SERVICE_SECRET=REPLACE_WITH_STRONG_SECRET

# ─── Event defaults (used as fallback if event.json is missing) ─────────────
EVENT_NAME="Grand Gala 2026"
EVENT_DATE="2026-12-31T19:00:00.000Z"
EVENT_VENUE="The Royal Palace Hall"

# ─── Misc ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
